# Dossiers générés automatiquement par Flutter pour les plateformes desktop/natives
windows/** linguist-generated=true
linux/** linguist-generated=true
macos/** linguist-generated=true
android/** linguist-generated=true
ios/** linguist-generated=true

# Fichiers CMake (au cas où il y en aurait ailleurs)
*.cmake linguist-generated=true
CMakeLists.txt linguist-generated=true

# Fichiers Dart générés automatiquement (build_runner, json_serializable, freezed, etc.)
*.g.dart linguist-generated=true
*.freezed.dart linguist-generated=true
*.gr.dart linguist-generated=true

# Dossier build (normalement déjà dans .gitignore, mais au cas où)
build/** linguist-generated=true

# Forcer Dart comme langage principal détecté
*.dart linguist-language=Dart